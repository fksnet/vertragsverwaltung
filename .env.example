# Application Configuration
APP_NAME="Vertragsverwaltung"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Berlin
APP_CURRENCY=EUR
APP_LOCALE=de_DE

# Security
APP_KEY=
ENCRYPTION_KEY=
CSRF_TOKEN_LIFETIME=3600

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=vertragsverwaltung
DB_USERNAME=root
DB_PASSWORD=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@vertragsverwaltung.local
MAIL_FROM_NAME="${APP_NAME}"

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# File Upload Configuration
MAX_UPLOAD_SIZE=26214400
ALLOWED_UPLOAD_MIMES=pdf
UPLOAD_PATH=uploads

# Rate Limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900

# 2FA Configuration
TOTP_ISSUER="${APP_NAME}"
TOTP_DIGITS=6
TOTP_ALGORITHM=sha1

# Notification Configuration
NOTIFICATION_REMINDER_DAYS=30,14,7,1
NOTIFICATION_EMAIL_ENABLED=true

# Audit Log Configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# Emergency Mode Configuration
EMERGENCY_ACCESS_LIFETIME=24
EMERGENCY_NOTIFICATION_EMAIL=admin@vertragsverwaltung.local