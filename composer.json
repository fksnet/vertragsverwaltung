{
    "name": "genspark/vertragsverwaltung",
    "description": "Moderne Familien-Vertragsverwaltung mit PHP 8.3, htmx und TailwindCSS",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^6.8",
        "vlucas/phpdotenv": "^5.5",
        "endroid/qr-code": "^4.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.34"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyze": "phpstan analyse --memory-limit=2G",
        "cs-check": "phpcs --standard=PSR12 app/ tests/",
        "cs-fix": "phpcbf --standard=PSR12 app/ tests/",
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "install-dev": [
            "@composer install",
            "npm install"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}